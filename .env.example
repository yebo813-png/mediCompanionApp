# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ==========================================
# SUPABASE CONFIGURATION
# ==========================================
# Get these from your Supabase project dashboard: https://supabase.com/dashboard
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ==========================================
# PAYMENT GATEWAY CONFIGURATION (South Africa)
# ==========================================

# PayFast (https://www.payfast.co.za/)
# Get credentials from Merchant Dashboard > Settings > Integration
PAYFAST_MERCHANT_ID="your-merchant-id"
PAYFAST_MERCHANT_KEY="your-merchant-key"
PAYFAST_PASSPHRASE="your-passphrase"
PAYFAST_SANDBOX="true"  # Set to "false" for production

# Peach Payments (https://peachpayments.com/)
# Get credentials from Peach Payments Dashboard
PEACH_PAYMENTS_ENTITY_ID="your-entity-id"
PEACH_PAYMENTS_PASSWORD="your-password"
PEACH_PAYMENTS_SANDBOX="true"

# Yoco (https://www.yoco.co.za/)
# Get credentials from Yoco Business Portal
YOCO_SECRET_KEY="sk_test_your-secret-key"
YOCO_PUBLIC_KEY="pk_test_your-public-key"
YOCO_SANDBOX="true"

# Ozow (https://ozow.com/)
# Get credentials from Ozow Merchant Portal
OZOW_SITE_CODE="your-site-code"
OZOW_PRIVATE_KEY="your-private-key"
OZOW_PUBLIC_KEY="your-public-key"
OZOW_SANDBOX="true"

# PayGate (https://www.paygate.co.za/)
# Get credentials from PayGate Merchant Portal
PAYGATE_MERCHANT_ID="your-merchant-id"
PAYGATE_ENCRYPTION_KEY="your-encryption-key"
PAYGATE_SANDBOX="true"

# Netcash (https://www.netcash.co.za/)
# Get credentials from Netcash Merchant Portal
NETCASH_MERCHANT_ID="your-merchant-id"
NETCASH_API_KEY="your-api-key"
NETCASH_SANDBOX="true"

# ==========================================
# PAYMENT WEBHOOK / CALLBACK URLS
# ==========================================
# These should point to your deployed application
PAYMENT_SUCCESS_URL="https://your-domain.com/payment/success"
PAYMENT_CANCEL_URL="https://your-domain.com/payment/cancel"
PAYMENT_WEBHOOK_URL="https://your-domain.com/api/payments/webhook"

# ==========================================
# APPLICATION SETTINGS
# ==========================================
NODE_ENV="development"
PORT="3000"